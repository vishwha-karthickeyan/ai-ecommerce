# Repository-level .gitignore

# Node / general
/node_modules
/dist
/build

# Env files
.env
.env.local
.env.*
!.env.example

# Logs
npm-debug.log*
.yarn-debug.log*
.yarn-error.log*

# Misc
.DS_Store
*.pem

# Python
__pycache__/
*.py[cod]

# Vercel / Next
.vercel
.next/
/out/

# Backend
/backend/__pycache__/
