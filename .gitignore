# Repository-level .gitignore

# Environment files & Secrets
.env
.env.local
.env.development
.env.production
.env.*
!.env.example
*.pem
*.key
*.crt

# Node / Dependencies / Builds
node_modules/
**/node_modules/
dist/
build/
.next/
out/
.vercel/

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/

# Logs & Databases
*.log
npm-debug.log*
yarn-debug.log*
*.db
*.sqlite
*.sqlite3

# OS & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

